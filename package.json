{
  "name": "taskforge",
  "displayName": "Task Forge",
  "description": "A customizable productivity forge for tasks, todos, notes, goals, and plans with Kanban, charts, and Git sync.",
  "version": "1.0.1",
  "publisher": "AnandShah",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnandShah10/TaskForge.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "todo",
    "tasks",
    "kanban",
    "notes",
    "goals",
    "planner",
    "productivity",
    "git-sync",
    "dashboard"
  ],
  "activationEvents": [
    "onView:taskForgeSidebar",
    "onCommand:taskForge.open"
  ],
  "main": "./out/extension.js",
  "dependencies": {
    "@hello-pangea/dnd": "^16.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.7"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskForge",
          "title": "TaskForge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "taskForge": [
        {
          "id": "taskForgeSidebar",
          "name": "TaskForge",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "taskForge.open",
        "title": "TaskForge: Open",
        "icon": "$(layout)"
      },
      {
        "command": "taskForge.exportToGit",
        "title": "Export to Git (.taskforge.json)",
        "category": "TaskForge",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "taskForge.importFromGit",
        "title": "Import from Git (.taskforge.json)",
        "category": "TaskForge",
        "icon": "$(cloud-download)"
      },
      {
        "command": "taskForge.refresh",
        "title": "Refresh TaskForge Views",
        "category": "TaskForge",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskForge.open",
          "when": "view == taskForgeSidebar",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "TaskForge",
      "properties": {
        "taskForge.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Auto-save changes."
        },
        "taskForge.autoGitSync": {
          "type": "boolean",
          "default": false,
          "description": "Prompt to export on save (for Git sync)."
        },
        "taskForge.maxItems": {
          "type": "number",
          "default": 100,
          "description": "Max items per category (trims oldest)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "vite build --config src/webview/vite.config.ts",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "npm run build:webview && webpack --mode production"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "eslint": "^8.56.0",
    "glob": "^10.3.12",
    "lucide-react": "^0.441.0",
    "mocha": "^11.3.0",
    "ts-loader": "^9.5.7",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
