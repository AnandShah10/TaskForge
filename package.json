{
  "name": "taskforge",
  "displayName": "TaskForge",
  "description": "A customizable productivity forge for tasks, todos, notes, goals, and plans with Kanban, charts, and Git sync.",
  "version": "0.4.0",
  "publisher": "AnandShah",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnandShah10/TaskForge.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "todo",
    "tasks",
    "kanban",
    "notes",
    "goals",
    "planner",
    "productivity",
    "git-sync",
    "dashboard"
  ],
  "activationEvents": [
    "onView:taskForge",
    "onCommand:taskForge.*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskForge",
          "title": "TaskForge",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "taskForge": [
        {
          "id": "hubView",
          "name": "Hub",
          "type": "tree",
          "icon": "media/hub.svg"
        },
        {
          "id": "todosView",
          "name": "Todos",
          "type": "tree",
          "icon": "media/todos.svg"
        },
        {
          "id": "notesView",
          "name": "Notes",
          "type": "tree",
          "icon": "media/notes.svg"
        },
        {
          "id": "tasksView",
          "name": "Tasks",
          "type": "tree",
          "icon": "media/tasks.svg"
        },
        {
          "id": "goalsView",
          "name": "Goals",
          "type": "tree",
          "icon": "media/goals.svg"
        },
        {
          "id": "plansView",
          "name": "Plans",
          "type": "tree",
          "icon": "media/plans.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "todosView",
        "contents": "No todos yet.\n[Add Todo](command:taskForge.addTodo)"
      },
      {
        "view": "notesView",
        "contents": "No notes yet.\n[Add Note](command:taskForge.addNote)"
      },
      {
        "view": "tasksView",
        "contents": "No tasks yet.\n[Add Task](command:taskForge.addTask)\n[Open Kanban Board](command:taskForge.openKanban)"
      },
      {
        "view": "goalsView",
        "contents": "No goals yet.\n[Add Goal](command:taskForge.addGoal)\n[View Goals Dashboard](command:taskForge.viewGoalsChart)"
      },
      {
        "view": "plansView",
        "contents": "No plans yet.\n[Add Plan](command:taskForge.addPlan)"
      }
    ],
    "commands": [
      {
        "command": "taskForge.addTodo",
        "title": "Add Todo",
        "category": "TaskForge",
        "icon": "$(add)"
      },
      {
        "command": "taskForge.addNote",
        "title": "Add Note",
        "category": "TaskForge",
        "icon": "$(add)"
      },
      {
        "command": "taskForge.addTask",
        "title": "Add Task",
        "category": "TaskForge",
        "icon": "$(add)"
      },
      {
        "command": "taskForge.addGoal",
        "title": "Add Goal",
        "category": "TaskForge",
        "icon": "$(add)"
      },
      {
        "command": "taskForge.addPlan",
        "title": "Add Plan",
        "category": "TaskForge",
        "icon": "$(add)"
      },
      {
        "command": "taskForge.openKanban",
        "title": "Open Kanban Board",
        "category": "TaskForge",
        "icon": "$(project)"
      },
      {
        "command": "taskForge.viewGoalsChart",
        "title": "View Goals Dashboard",
        "category": "TaskForge",
        "icon": "$(graph-line)"
      },
      {
        "command": "taskForge.exportToGit",
        "title": "Export to Git (.taskforge.json)",
        "category": "TaskForge",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "taskForge.importFromGit",
        "title": "Import from Git (.taskforge.json)",
        "category": "TaskForge",
        "icon": "$(cloud-download)"
      },
      {
        "command": "taskForge.searchItems",
        "title": "Search Items",
        "category": "TaskForge",
        "icon": "$(search)"
      },
      {
        "command": "taskForge.editItem",
        "title": "Edit Item",
        "category": "TaskForge",
        "icon": "$(edit)"
      },
      {
        "command": "taskForge.deleteItem",
        "title": "Delete Item",
        "category": "TaskForge",
        "icon": "$(trash)"
      },
      {
        "command": "taskForge.toggleItem",
        "title": "Toggle Item Status",
        "category": "TaskForge",
        "icon": "$(check)"
      },
      {
        "command": "taskForge.refresh",
        "title": "Refresh TaskForge Views",
        "category": "TaskForge",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskForge.addTodo",
          "when": "view == todosView",
          "group": "navigation@1"
        },
        {
          "command": "taskForge.addNote",
          "when": "view == notesView",
          "group": "navigation@1"
        },
        {
          "command": "taskForge.addTask",
          "when": "view == tasksView",
          "group": "navigation@1"
        },
        {
          "command": "taskForge.openKanban",
          "when": "view == tasksView",
          "group": "navigation@2"
        },
        {
          "command": "taskForge.addGoal",
          "when": "view == goalsView",
          "group": "navigation@1"
        },
        {
          "command": "taskForge.viewGoalsChart",
          "when": "view == goalsView",
          "group": "navigation@2"
        },
        {
          "command": "taskForge.addPlan",
          "when": "view == plansView",
          "group": "navigation@1"
        },
        {
          "command": "taskForge.refresh",
          "when": "view == hubView || view == todosView || view == notesView || view == tasksView || view == goalsView || view == plansView",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "taskForge.editItem",
          "when": "view == todosView || view == notesView || view == tasksView || view == goalsView || view == plansView",
          "group": "inline@1"
        },
        {
          "command": "taskForge.toggleItem",
          "when": "view == todosView || view == tasksView",
          "group": "inline@2"
        },
        {
          "command": "taskForge.deleteItem",
          "when": "view == todosView || view == notesView || view == tasksView || view == goalsView || view == plansView",
          "group": "inline@3"
        }
      ],
      "view/container/title": [
        {
          "command": "taskForge.searchItems",
          "when": "viewContainer == taskForge",
          "group": "navigation@1"
        },
        {
          "command": "taskForge.exportToGit",
          "when": "viewContainer == taskForge",
          "group": "1_sync@1"
        },
        {
          "command": "taskForge.importFromGit",
          "when": "viewContainer == taskForge",
          "group": "1_sync@2"
        },
        {
          "command": "taskForge.refresh",
          "when": "viewContainer == taskForge",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "taskForge.editItem",
          "when": "false"
        },
        {
          "command": "taskForge.deleteItem",
          "when": "false"
        },
        {
          "command": "taskForge.toggleItem",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "TaskForge",
      "properties": {
        "taskForge.autoGitSync": {
          "type": "boolean",
          "default": false,
          "description": "Automatically export to .taskforge.json whenever a todo is added (for Git sync)."
        },
        "taskForge.maxItems": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum number of items kept per category; oldest items are trimmed first."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "webpack --mode production"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.56.0",
    "glob": "^10.3.12",
    "mocha": "^11.3.0",
    "ts-loader": "^9.5.7",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
